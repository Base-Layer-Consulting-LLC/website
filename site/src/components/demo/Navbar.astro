---
const links = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
];
---

<nav class="navbar bg-base-200 border-b">
  <div class="page-container flex items-center justify-between gap-4">
    <a href="/" class="font-bold text-lg"> Astro Starter </a>

    <ul class="menu menu-horizontal gap-2">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="btn btn-ghost btn-sm">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
