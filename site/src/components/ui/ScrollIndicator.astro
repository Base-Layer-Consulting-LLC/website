---
import { PhMouseSimple, PhCaretDoubleDown } from "phosphor-icons-astro";
---

<div
  class="flex flex-col items-center gap-2 opacity-60 pointer-events-none select-none"
>
  <!-- Desktop -->
  <div class="hidden md:flex flex-col items-center gap-2">
    <PhMouseSimple class="h-8 w-8 animate-[float_2s_ease-in-out_infinite]" />

    <span class="text-xs uppercase tracking-[0.25em]"> Scroll </span>
  </div>

  <!-- Mobile -->
  <div class="flex md:hidden flex-col items-center gap-2">
    <PhCaretDoubleDown
      class="h-8 w-8 animate-[float_2s_ease-in-out_infinite]"
    />

    <span class="text-xs uppercase tracking-[0.25em]"> Swipe </span>
  </div>
</div>
