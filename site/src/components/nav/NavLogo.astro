---
import { Image } from "astro:assets";
import brandLogo from "../../assets/img/brand/logo/base-layer-logo-square-no-text-transparent.png";

interface Props {
  size?: number;
  alt?: string;
}

const { size = 40, alt = "Base Layer Consulting logo" } = Astro.props;
---

<Image
  src={brandLogo}
  alt={alt}
  width={size}
  height={size}
  class="block"
  loading="eager"
/>
