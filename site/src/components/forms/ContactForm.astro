---
import { site } from "../../config/site";
import { PhPaperPlaneTilt } from "phosphor-icons-astro";
---

<form
  action={`https://formspree.io/f/${site.formspreeContactFormId}`}
  method="POST"
  class="space-y-5 sm:space-y-6"
>
  <input
    type="email"
    name="email"
    placeholder="Your email"
    required
    class="input input-bordered w-full"
  />

  <input
    type="tel"
    name="phone"
    placeholder="Your phone number (optional)"
    class="input input-bordered w-full"
  />

  <textarea
    name="message"
    placeholder="Your message"
    required
    class="textarea textarea-bordered w-full min-h-48 sm:min-h-56 lg:min-h-64"
    rows="6"></textarea>

  <button class="btn btn-info w-full text-content opacity-80" type="submit">
    <PhPaperPlaneTilt class="text-lg text-content" />
    <span class="text-lg">Send</span>
  </button>
</form>
