---
interface Props {
  title?: string;
}

const { title = "Astro Site" } = Astro.props;

import "../../styles/global.css";
import Navbar from "../../components/demo/Navbar.astro";
import Footer from "../../components/demo/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body class="page-shell">
    <Navbar />

    <main class="page-main">
      <div class="page-container">
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>
