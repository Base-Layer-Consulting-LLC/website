---
import ScrollSectionLayout from "../layouts/ScrollSectionLayout.astro";
import LogoTransparent from "../components/image/logo/LogoTransparent.astro";
import ContactForm from "../components/forms/ContactForm.astro";
import Animate from "../components/animate/Animate.astro";
import ServiceCard from "../components/cards/ServiceCard.astro";
import { PhRobot } from "phosphor-icons-astro";
import { PhCloud } from "phosphor-icons-astro";
import { PhCraneTower } from "phosphor-icons-astro";
import { PhHeartbeat } from "phosphor-icons-astro";
import { PhQuestion } from "phosphor-icons-astro";
import { siteConfig } from "../config/site";
---

<ScrollSectionLayout title={siteConfig.name}>
  <section class="snap-start min-h-dvh flex items-center justify-center px-6">
    <div class="max-w-5xl text-center space-y-6 flex flex-col items-center">
      <Animate animate="fadeInDown" duration="1.5s">
        <LogoTransparent class="h-32 w-32 sm:h-32 sm:w-32 lg:h-48 lg:w-48" />
      </Animate>

      <Animate animate="fadeInDown" delay="0.5s" duration="1s">
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-bold">
          {siteConfig.name}
        </h1>
      </Animate>

      <Animate animate="fadeInUp" delay="0.5s">
        <p class="text-lg sm:text-xl opacity-80 pt-3">
          {siteConfig.tagline}
        </p>
      </Animate>

      <Animate animate="jackInTheBox" delay="1.5s">
        <div class="pt-6 text-md opacity-70 space-y-2">
          <p>© {new Date().getFullYear()} {siteConfig.name}</p>
          <p>{siteConfig.emailMain}</p>
        </div>
      </Animate>
    </div>
  </section>

  <section
    class="snap-start min-h-dvh flex items-start md:items-center justify-center px-6 py-10 md:py-8"
    data-animate-section
  >
    <div class="mx-auto max-w-5xl w-full text-center space-y-8">
      <div class="max-w-2xl mx-auto pt-6 md:pt-0 space-y-4">
        <div data-animate-item class="opacity-0">
          <h2 class="text-4xl sm:text-5xl lg:text-7xl font-bold pb-4 md:pb-2">
            Services
          </h2>
        </div>

        <div data-animate-item class="opacity-0">
          <p class="mt-4 py-4 text-base sm:text-lg opacity-80">
            With over a decade of experience in both infrastructure and backend
            software development, I help small businesses and growing teams
            build a stable foundation for business success
          </p>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-6">
        <ServiceCard
          title="Automation"
          body="Streamline repetitive tasks and improve workflows with simple, practical automation. Turn pain points into background noise."
          delay="0s"
          class="sm:col-span-1 xl:col-span-2"
        >
          <PhRobot slot="icon" class="h-5 w-5 opacity-80" />
        </ServiceCard>

        <ServiceCard
          title="Cloud & Infrastructure"
          body="Optimize spend by finding over-provisioned resources and ineffeficiencies in your environment. Set up or improve application monitoring and alerting. Feel peace of mind with a good backup strategy for your core infrastructure."
          delay="0.15s"
          class="sm:col-span-1 xl:col-span-2"
        >
          <PhCloud slot="icon" class="h-5 w-5 opacity-80" />
        </ServiceCard>

        <ServiceCard
          title="Platform Engineering"
          body="Improve Developer velocity and experience with GitOps and DevOps. I build platforms, tools, and processes to reduce friction and let Developers do what they do best: build."
          delay="0.3s"
          class="sm:col-span-1 xl:col-span-2"
        >
          <PhCraneTower slot="icon" class="h-5 w-5 opacity-80" />
        </ServiceCard>

        <ServiceCard
          title="Monitoring"
          body="Visibility into systems and services so problems are caught before they become outages. Detect problems in real time, and scope in on where they originated. Let me do the sleuthing while you get back to building."
          delay="0.45s"
          class="sm:col-span-1 xl:col-start-2 xl:col-span-2"
        >
          <PhHeartbeat slot="icon" class="h-5 w-5 opacity-80" />
        </ServiceCard>

        <ServiceCard
          title="Consulting"
          body="Architecture planning, software development lifecycle design, choosing the tools for your trade, and building a stable technical foundation you can grow your business on."
          delay="0.6s"
          class="sm:col-span-1 xl:col-span-2"
        >
          <PhQuestion slot="icon" class="h-5 w-5 opacity-80" />
        </ServiceCard>
      </div>
    </div>
  </section>

  <section
    class="snap-start min-h-dvh flex items-center justify-center px-0 sm:px-6 py-6 sm:py-10"
    data-animate-section
  >
    <div
      data-animate-item
      class="opacity-0 w-full max-w-none sm:max-w-2xl rounded-none sm:rounded-3xl border border-base-300 bg-base-100/80 p-4 sm:p-8 shadow-none sm:shadow-xl"
    >
      <div class="text-center space-y-4 mb-6 sm:mb-8">
        <div data-animate-item class="opacity-0">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold">Contact</h2>
        </div>

        <div data-animate-item class="opacity-0">
          <p class="text-base sm:text-lg opacity-80">
            Send a message and I'll get back to you by email.
          </p>
        </div>

        <div data-animate-item class="opacity-0">
          <p class="text-base sm:text-sm opacity-80">
            (response time: 3-5 business days)
          </p>
        </div>
      </div>

      <div data-animate-item class="opacity-0">
        <ContactForm />
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const sections = document.querySelectorAll("[data-animate-section]");
      if (!sections.length || !("IntersectionObserver" in window)) return;

      const isMobile = window.matchMedia("(max-width: 767px)").matches;

      const options = isMobile
        ? {
            threshold: 0.15,
            rootMargin: "0px 0px -20% 0px",
          }
        : {
            threshold: 0.45,
            rootMargin: "0px 0px -10% 0px",
          };

      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const items = entry.target.querySelectorAll("[data-animate-item]");
          items.forEach((el, i) => {
            el.classList.remove("opacity-0");
            el.classList.add("animate__animated", "animate__fadeInUp");
            el.style.setProperty("--animate-duration", "0.8s");
            el.style.setProperty("--animate-delay", `${i * 0.15}s`);
          });

          obs.unobserve(entry.target);
        });
      }, options);

      sections.forEach((section) => observer.observe(section));
    })();
  </script>
</ScrollSectionLayout>
